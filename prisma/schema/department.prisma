model Department {
    id          String      @id @default(uuid())
    name        String      @unique
    code        String      @unique
    description String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    staff       User[]
    complaints  Complaint[]

    @@map("departments")
}

model DepartmentDel {
    id                   String   @id @default(uuid())
    originalDepartmentId String
    name                 String
    code                 String
    dataSnapshot         Json
    deletedBy            String?
    deletedAt            DateTime @default(now())
    deletionReason       String?

    @@map("departments_del")
}
