						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"User requested account removal.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "users", "{{userId}}"]
						}
