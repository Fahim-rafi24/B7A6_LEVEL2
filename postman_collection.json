					}
				},
				{
					"name": "Manage Users (List with Role Filter)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/users?role=STAFF",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "users"]
						}
					}
				},
				{
					"name": "Update User Role (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
